import cv2
import numpy as np
import matplotlib.pyplot as plt
import os

# Automatic image search
files = [f for f in os.listdir('/content') if f.endswith(('.jpg', '.png', '.jpeg'))]

if files:
    img_path = os.path.join('/content', files[0])
    img = cv2.imread(img_path)
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    # Thresholding white obstacles & potholes
    _, thresh = cv2.threshold(gray, 180, 255, cv2.THRESH_BINARY)
    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    count = 0
    for cnt in contours:
        if cv2.contourArea(cnt) > 20: # Area filter
            count += 1
            x, y, w, h = cv2.boundingRect(cnt)
            cv2.rectangle(img, (x, y), (x + w, y + h), (0, 255, 0), 2)
            cv2.putText(img, f"({x},{y})", (x, y - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (255, 0, 0), 1)

    cv2.putText(img, f"Total Obstacles/Potholes: {count}", (20, 30), 
                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)

    # Save & Show
    cv2.imwrite('output_task3.jpg', img)
    plt.figure(figsize=(8, 5))
    plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    plt.title(f"Task 3: {count} Obstacles Detected")
    plt.axis('off')
    plt.show()
