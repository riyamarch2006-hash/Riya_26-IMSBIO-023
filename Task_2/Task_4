import cv2
import numpy as np
import matplotlib.pyplot as plt
import os

files = [f for f in os.listdir('/content') if f.endswith(('.jpg', '.png', '.jpeg'))]

if files:
    img_path = os.path.join('/content', files[0])
    img = cv2.imread(img_path)
    h, w, _ = img.shape

    # Track ke hisab se outer loop checkpoints
    waypoints = np.array([
        [int(w * 0.25), int(h * 0.75)],
        [int(w * 0.25), int(h * 0.25)],
        [int(w * 0.75), int(h * 0.25)],
        [int(w * 0.75), int(h * 0.75)],
        [int(w * 0.25), int(h * 0.75)]
    ], np.int32)

    # Path Draw karna
    cv2.polylines(img, [waypoints], isClosed=True, color=(255, 0, 0), thickness=4)
    for pt in waypoints:
        cv2.circle(img, tuple(pt), 6, (0, 255, 255), -1)

    # Save & Show
    cv2.imwrite('output_task4.jpg', img)
    plt.figure(figsize=(8, 5))
    plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    plt.title("Task 4: Aerial Path Planning")
    plt.axis('off')
    plt.show()
